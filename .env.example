# Copy to .env and fill in. Every variable the code reads is listed here.

# --- Required ---

# Postgres connection string (prisma/schema.prisma uses provider "postgresql").
# Production runs on Neon. When the URL contains "neon", src/lib/prisma.ts
# connects through the @prisma/adapter-neon serverless driver; any other
# Postgres URL uses the standard Prisma engine.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# NextAuth. NEXTAUTH_URL is the public origin and is also used to build
# password reset links. NEXTAUTH_SECRET signs the session JWT and is read by
# src/proxy.ts to gate /lobby and /admin. Generate one: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-strong-random-secret"

# --- Optional ---

# Google sign-in. The provider is only enabled when both values are set.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend, for password reset emails. Without these, development logs the
# reset link to the server console and production skips sending.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Bureau21 <noreply@example.com>"
