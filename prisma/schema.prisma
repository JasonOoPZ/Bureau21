generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String?   @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?
  role           String    @default("player")
  suspended      Boolean   @default(false)
  walletAddress  String?
  pilotState     PilotState?
  accounts       Account[]
  sessions       Session[]
  boardPosts         BoardPost[]
  boardVotes         BoardVote[]
  chatMessages       ChatMessage[]
  quickPostsSent     QuickPost[]     @relation("QuickPostFrom")
  quickPostsReceived QuickPost[]     @relation("QuickPostTo")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model PilotState {
  id                String          @id @default(cuid())
  userId            String          @unique
  callsign          String
  /// Lower-cased, whitespace-normalised callsign. Unique: this is what makes
  /// callsigns unique ignoring case. Written by callsignFields() and kept in
  /// step by the PilotState_callsignLower_sync trigger (see the migration).
  callsignLower     String?         @unique
  characterSlug     String          @default("base-red")
  gender            String          @default("unspecified")
  level             Int             @default(1)
  xp                Int             @default(0)
  credits           Int             @default(300)
  tokens            Int             @default(0)
  fuel              Int             @default(10)
  hull              Int             @default(100)
  lifeForce         Int             @default(15)
  /// Life Force bought with allocation points. Part of the pilot's maximum.
  bonusLifeForce    Int             @default(0)
  motivation        Int             @default(100)
  strength          Float           @default(3.0)
  speed             Float           @default(5.0)
  endurance         Float           @default(0.2)
  panic             Float           @default(0.0)
  confidence        Float           @default(5.0)
  lastConfidenceResetAt DateTime    @default(now())
  atkSplit          Int             @default(50)
  appearanceSelections Int          @default(0)
  appearanceNeedsSetup Boolean      @default(false)
  theme             String          @default("original")
  customQuicklinks  String          @default("[]")
  gymStreak         Int             @default(0)
  currentSector     String          @default("Fringe Expanse")
  kills             Int             @default(0)
  bounty            Int             @default(0)
  ore               Int             @default(0)
  herbs             Int             @default(0)
  lastActionAt      DateTime        @default(now())
  lastFuelRegen     DateTime        @default(now())
  lastGymAt         DateTime?
  lastMotivationAt  DateTime        @default(now())
  lastHydroAt       DateTime        @default(now())
  lastDockAt        DateTime        @default(now())
  lastFabAt         DateTime        @default(now())
  lastPackAt        DateTime?
  lastOutpostClaim  DateTime?
  fish              Int             @default(0)
  creditsBank       Int             @default(0)
  loanAmount        Int             @default(0)
  loanCreatedAt     DateTime?
  bondAmount        Int             @default(0)
  bondRate          Float           @default(0)
  bondDays          Int             @default(0)
  bondCreatedAt     DateTime?
  bondMaturesAt     DateTime?
  bondLastClaimedAt DateTime?
  gymEnergy         Int             @default(27)
  lastGymEnergyAt   DateTime        @default(now())
  autoHerbs         Boolean         @default(false)
  hideBattleLogs    Boolean         @default(false)
  battleCooldown    Int             @default(5)
  combatStimUse     String          @default("attack_or_defend")
  simTrainsToday    Int             @default(0)
  lastSimTrainAt    DateTime?
  lastAttackedAt    DateTime?
  unspentPoints     Int             @default(0)
  missions          Mission[]
  inventory         InventoryItem[]
  battleLogs        BattleLog[]
  syndicateMember   SyndicateMember?
  heroes            PlayerHero[]
  studies           StudyProgress[]
  gymLogs           GymLog[]
  hydroponics       HydroponicsData?
  wealthInvestments WealthInvestment[]
  casinoBets        CasinoBet[]
  crashRuns         CrashRun[]
  watchlistOwned    Watchlist[]     @relation("WatchlistOwner")
  watchlistTargeted Watchlist[]     @relation("WatchlistTarget")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WealthInvestment {
  id            String   @id @default(cuid())
  pilotId       String
  name          String
  amount        Int
  rate          Float
  days          Int
  createdAt     DateTime @default(now())
  maturesAt     DateTime
  lastClaimedAt DateTime

  pilot PilotState @relation(fields: [pilotId], references: [id], onDelete: Cascade)

  @@unique([pilotId, days])
  @@index([pilotId])
}

model BattleLog {
  id            String     @id @default(cuid())
  pilotId       String
  opponentName  String
  result        String
  xpGained      Int
  creditsGained Int
  roundsCount   Int
  logText       String
  /// The other pilot's id. Null on rows written before this column existed
  /// (the migration backfills what it can from opponentName).
  opponentPilotId String?
  /// "attacker" | "defender": which side `pilotId` fought on. Null on old rows.
  role          String?
  /// "pvp" today; leaves room for PvE logs without mixing them into PvP caps.
  kind          String     @default("pvp")
  createdAt     DateTime   @default(now())

  pilot PilotState @relation(fields: [pilotId], references: [id], onDelete: Cascade)

  @@index([pilotId])
  @@index([pilotId, createdAt])
  @@index([pilotId, opponentPilotId, createdAt])
  @@index([pilotId, role, createdAt])
}

model InventoryItem {
  id        String   @id @default(cuid())
  pilotId   String
  name      String
  type      String
  tier      Int
  bonusType String
  bonusAmt  Int
  equipped  Boolean  @default(false)
  createdAt DateTime @default(now())

  pilot PilotState @relation(fields: [pilotId], references: [id], onDelete: Cascade)

  @@index([pilotId])
}

model Mission {
  id           String   @id @default(cuid())
  pilotId      String
  title        String
  description  String
  rewardXp     Int
  rewardCredits Int
  targetCount  Int
  currentCount Int      @default(0)
  completed    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pilot PilotState @relation(fields: [pilotId], references: [id], onDelete: Cascade)

  @@unique([pilotId, title])
  @@index([pilotId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
}

model BoardPost {
  id        String   @id @default(cuid())
  authorId  String
  category  String   @default("general")
  title     String
  body      String
  /// Always the sum of BoardVote.direction for this post.
  karma     Int      @default(0)
  createdAt DateTime @default(now())

  author User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  votes  BoardVote[]

  @@index([authorId])
  @@index([category])
  @@index([createdAt])
}

/// One row per (post, user). Changing a vote updates the row; withdrawing it
/// deletes the row. BoardPost.karma is adjusted by the difference.
model BoardVote {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  direction Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post BoardPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  authorId  String
  body      String
  createdAt DateTime @default(now())

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([createdAt])
}

model Syndicate {
  id          String            @id @default(cuid())
  name        String            @unique
  tag         String            @unique
  description String            @default("")
  treasury    Int               @default(0)
  leaderId    String
  members     SyndicateMember[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model SyndicateMember {
  id          String    @id @default(cuid())
  syndicateId String
  pilotId     String    @unique
  role        String    @default("member")
  joinedAt    DateTime  @default(now())

  syndicate   Syndicate  @relation(fields: [syndicateId], references: [id], onDelete: Cascade)
  pilot       PilotState @relation(fields: [pilotId], references: [id], onDelete: Cascade)
}

model QuickPost {
  id          String   @id @default(cuid())
  fromId      String
  toId        String
  body        String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  from User @relation("QuickPostFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   User @relation("QuickPostTo",   fields: [toId],   references: [id], onDelete: Cascade)

  @@index([toId])
  @@index([fromId])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sessionToken])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model GameGlobal {
  id            String @id @default("singleton")
  bankTreasury  Int    @default(0)
}

model PlayerHero {
  id        String   @id @default(cuid())
  pilotId   String
  heroSlug  String
  level     Int      @default(1)
  xp        Int      @default(0)
  active    Boolean  @default(false)
  createdAt DateTime @default(now())

  pilot PilotState @relation(fields: [pilotId], references: [id], onDelete: Cascade)

  @@index([pilotId])
}

model GymLog {
  id         String   @id @default(cuid())
  pilotId    String
  training   String
  gain       Float
  energyCost Int
  createdAt  DateTime @default(now())

  pilot PilotState @relation(fields: [pilotId], references: [id], onDelete: Cascade)

  @@index([pilotId])
  @@index([pilotId, createdAt])
}

model StudyProgress {
  id        String   @id @default(cuid())
  pilotId   String
  course    String
  points    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pilot PilotState @relation(fields: [pilotId], references: [id], onDelete: Cascade)

  @@index([pilotId])
  @@unique([pilotId, course])
}

model HydroponicsData {
  id        String   @id @default(cuid())
  pilotId   String   @unique
  gameState Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pilot PilotState @relation(fields: [pilotId], references: [id], onDelete: Cascade)
}

model Watchlist {
  id            String   @id @default(cuid())
  pilotId       String
  targetPilotId String
  blockComms    Boolean  @default(false)
  notes         String   @default("")
  createdAt     DateTime @default(now())

  pilot       PilotState @relation("WatchlistOwner", fields: [pilotId], references: [id], onDelete: Cascade)
  targetPilot PilotState @relation("WatchlistTarget", fields: [targetPilotId], references: [id], onDelete: Cascade)

  @@unique([pilotId, targetPilotId])
  @@index([pilotId])
}

model CasinoBet {
  id        String   @id @default(cuid())
  pilotId   String
  game      String
  bet       Int
  payout    Int
  net       Int
  createdAt DateTime @default(now())

  pilot PilotState @relation(fields: [pilotId], references: [id], onDelete: Cascade)

  @@index([pilotId])
  @@index([pilotId, game])
  @@index([pilotId, createdAt])
}

/// A Void Runner (crash) run. Persisted so any serverless instance can settle
/// it. A partial unique index (raw SQL in the migration, Prisma cannot express
/// it) allows at most one row with status = 'open' per pilot.
model CrashRun {
  id         String    @id @default(cuid())
  pilotId    String
  bet        Int
  /// Hidden until the run is settled.
  crashPoint Float
  /// "open" | "cashed_out" | "crashed"
  status     String    @default("open")
  startedAt  DateTime  @default(now())
  /// Server time of the first cash-out request. Retries settle at this time.
  cashOutAt  DateTime?
  settledAt  DateTime?
  payout     Int       @default(0)

  pilot PilotState @relation(fields: [pilotId], references: [id], onDelete: Cascade)

  @@index([pilotId, startedAt])
  @@index([status, startedAt])
}

/// Sliding-window rate-limit hits shared by every serverless instance.
/// `key` is a SHA-256 hash, never a raw email or IP.
model RateLimitHit {
  id      String   @id @default(cuid())
  key     String
  expires DateTime

  @@index([key, expires])
  @@index([expires])
}
